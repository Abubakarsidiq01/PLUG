# Copy to .env.local. NEVER commit .env.local — it is gitignored, along with
# every other .env.* file except this one. Every variable the backend reads is
# validated at startup by EnvironmentSafetyCheck; an invalid or missing
# critical value fails the process before it serves a request (manual.docx §1.3.4).

# ---- Shared ---------------------------------------------------------------
PLUG_ENVIRONMENT=local                 # local | staging — see EnvironmentSafetyCheck
PLUG_BIND_ADDRESS=127.0.0.1

# ---- Backend (Person One) --------------------------------------------------
PLUG_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/plug
PLUG_DATABASE_USER=plug
PLUG_DATABASE_PASSWORD=                # required by infra/compose.yml and the db profile; set a local-only value

# Flyway connects separately from the application pool in staging so migrations
# can run with a narrower, higher-privileged account (spring.profiles.active=staging).
PLUG_MIGRATION_DATABASE_URL=
PLUG_MIGRATION_DATABASE_USER=
PLUG_MIGRATION_DATABASE_PASSWORD=

PLUG_JWT_ISSUER=                       # staging only — must be an https:// issuer, see SecurityConfiguration
PLUG_JWT_AUDIENCE=                     # staging only — plug-api

# Identity and consent (Phase 1). Required whenever the db or staging profile is active,
# including for `./dev databaseTest`. The pepper keys the one-way values stored for phone
# numbers, Apple subjects and one-time codes: without it a leaked database could be
# brute-forced back into all three, because each lives in a small enough space to try.
# At least 32 characters, from secret storage, never reused between environments, and
# rotating it makes every stored identity unrecognisable — treat it as permanent.
PLUG_IDENTITY_PEPPER=
PLUG_APPLE_CLIENT_ID=                  # the app's bundle identifier; staging requires it

# ---- iOS (Person One) -------------------------------------------------------
# Set as scheme environment variables in Xcode, not here — see ios/README.md.
# PLUG_API_URL=https://api-staging.plug.app
# PLUG_WEB_URL=https://plug-web-staging.example   # where the Terms and Privacy pages live

# ---- Web (Person Two) --------------------------------------------------------
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Rules ------------------------------------------------------------------
# 1. Anything NEXT_PUBLIC_* ships to the browser. Treat it as published.
# 2. Staging and production values live in the secret-storage plan (infra/), never
#    pasted into chat, a document, a screenshot, a fixture or a commit.
# 3. If a value is ever exposed: rotate first, investigate second.
