#!/bin/sh
set -eu
cd "$(dirname "$0")"
plug_root=$(cd .. && pwd)
if [ -z "${JAVA_HOME:-}" ]; then
    for plug_jdk in "$plug_root"/.tools/jdk-*/Contents/Home; do
        if [ -x "$plug_jdk/bin/java" ]; then
            JAVA_HOME="$plug_jdk"
            export JAVA_HOME
            break
        fi
    done
fi
export GRADLE_USER_HOME="${GRADLE_USER_HOME:-$plug_root/.tools/gradle-home}"
exec ./gradlew "$@"
