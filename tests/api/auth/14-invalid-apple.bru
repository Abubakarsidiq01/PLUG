meta {
  name: Phase 1 - invalid-apple
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/auth/apple
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"identity_token": "invalid-token", "nonce": "device-nonce-0000000001", "consent_version": "2026-09-01"}
}

assert {
  res.status: eq 401
  res.body.error.code: eq unauthenticated
}
