meta {
  name: Phase 1 - replay
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"refresh_token": "{{p1Refresh}}"}
}

assert {
  res.status: eq 401
  res.body.error.code: eq unauthenticated
}
