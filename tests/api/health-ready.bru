meta {
  name: GET /health/ready
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/health/ready
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: isDefined
  res.body.checks: isDefined
}

tests {
  test("readiness and liveness are separate endpoints", function () {
    const body = res.getBody();
    expect(body.status).to.equal("UP");
    expect(body.checks).to.be.an("object");
  });
}
