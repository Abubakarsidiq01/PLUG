meta {
  name: Become a provider on the same account
  type: http
  seq: 47
}

post {
  url: {{baseUrl}}/v1/providers/skills
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{p2Other}}
}

body:json {
  {"skill_tags":["braids","wig_install"],"travel_radius_m":4828,"base_location":{"latitude":32.528,"longitude":-92.714,"precision":"coarse"},"availability":[{"days":"every_day","from":"08:00","to":"21:00"}],"time_zone":"America/Chicago"}
}

assert {
  res.status: eq 200
  res.body.score.state: eq new
  res.body.accepting: eq true
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });
}
