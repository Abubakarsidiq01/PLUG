meta {
  name: Invalid longitude
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/v1/requests
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{p2Other}}
  Idempotency-Key: {{p2Run}}-Invalid-longitude
}

body:json {
  {"text":"Barber under $35 in 30 minutes","location":{"latitude":32.528,"longitude":181,"precision":"coarse"}}
}

assert {
  res.status: eq 400
  res.body.error.code: eq validation_failed
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });

}
