meta {
  name: Answer key conflict
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/v1/requests/{{p2Draft}}/clarifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{p2Owner}}
  Idempotency-Key: {{p2Run}}-answer
}

body:json {
  {"clarification_id":"{{p2Clarification}}","value":"beauty"}
}

assert {
  res.status: eq 409
  res.body.error.code: eq conflict
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });

}
