meta {
  name: Unknown request
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/v1/requests/req_unknown
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{p2Owner}}
}

assert {
  res.status: eq 404
  res.body.error.code: eq not_found
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });

}
