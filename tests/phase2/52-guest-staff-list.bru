meta {
  name: A guest cannot list staff
  type: http
  seq: 52
}

get {
  url: {{baseUrl}}/v1/admin/staff
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{p2Owner}}
}

assert {
  res.status: eq 403
  res.body.error.code: eq forbidden
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });
}
