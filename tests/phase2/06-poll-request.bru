meta {
  name: Poll request
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/requests/{{p2Request}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{p2Owner}}
}

assert {
  res.status: eq 200
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });
  test("server progress invariants", function () { const p=res.getBody().progress; expect(p.replied).to.be.at.most(p.contacted); expect(p.offers_ready).to.be.at.most(p.replied); });
}
