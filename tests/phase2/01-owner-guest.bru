meta {
  name: Owner guest
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/auth/guest
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"consent_version":"2026-09-01"}
}

script:pre-request {
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::[0-9]+)?\/?$/.test(bru.getEnvVar("baseUrl"))) throw new Error("Use only a disposable loopback Phase 2 backend.");
  bru.setVar("p2Run", "p2-" + Date.now() + "-" + Math.random().toString(36).slice(2));
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("p2Owner", res.getBody().access_token);
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });

}
