meta {
  name: Create clarification
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/requests
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{p2Owner}}
  Idempotency-Key: {{p2Run}}-draft
}

body:json {
  {"text":"Something nearby","location":{"latitude":32.528,"longitude":-92.714,"precision":"coarse"}}
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("p2Draft", res.getBody().request_id);
  bru.setVar("p2Clarification", res.getBody().clarification.clarification_id);
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });
  test("one category question", function () { expect(res.getBody().clarification.field).to.deep.equal("category"); });
}
