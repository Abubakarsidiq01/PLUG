meta {
  name: Invalid latitude
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/v1/requests
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{p2Other}}
  Idempotency-Key: {{p2Run}}-Invalid-latitude
}

body:json {
  {"text":"Barber under $35 in 30 minutes","location":{"latitude":91,"longitude":-92.714,"precision":"coarse"}}
}

assert {
  res.status: eq 400
  res.body.error.code: eq validation_failed
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });

}
