meta {
  name: Answer category
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/requests/{{p2Draft}}/clarifications
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{p2Owner}}
  Idempotency-Key: {{p2Run}}-answer
}

body:json {
  {"clarification_id":"{{p2Clarification}}","value":"barber"}
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("p2AnswerBody", JSON.stringify(res.getBody()));
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });
  test("canonical category", function () { expect(res.getBody().constraints.category).to.deep.equal("barber"); });
}
