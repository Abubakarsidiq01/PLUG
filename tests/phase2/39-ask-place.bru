meta {
  name: Ask a place question (manual v4)
  type: http
  seq: 39
}

post {
  url: {{baseUrl}}/v1/asks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{p2Owner}}
  Idempotency-Key: {{p2Run}}-Ask-place
}

body:json {
  {"text":"How long is the line at Walmart on Ben White?","location":{"latitude":32.528,"longitude":-92.714,"precision":"coarse"},"time_zone":"America/Chicago"}
}

assert {
  res.status: eq 201
  res.body.ask_type: eq place_question
  res.body.place_question.answer: isNull
}

tests {
  test("correlation identifier returned", function () {
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.empty;
  });
  test("no human answer is invented", function () { expect(["asking", "unknown"]).to.include(res.getBody().place_question.status); });
}
