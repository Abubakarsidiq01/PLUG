diff --git a/web/src/app/_components/truth-badge.tsx b/web/src/app/_components/truth-badge.tsx
index e5b526b..a705aa0 100644
--- a/web/src/app/_components/truth-badge.tsx
+++ b/web/src/app/_components/truth-badge.tsx
@@ -1,15 +1,21 @@
-// manual.docx §11.2: the only place truth colours may appear. In the product the
+// Manual v4 §11.2: the only place truth colours may appear. In the product the
 // label is decoded from a server response and never computed by a client; on the
 // public site it is only shown as a specimen next to its definition.
-export type TruthLabel = "confirmed" | "recent" | "estimated" | "unknown";
+//
+// Four labels are filled because a person reported something. The fifth,
+// not_verified, is a web answer nobody checked, and it is drawn with a dashed
+// outline instead of a fill so the difference survives greyscale and sunlight.
+export type TruthLabel = "confirmed" | "recent" | "estimated" | "unknown" | "not_verified";
 
 const names: Record<TruthLabel, string> = {
   confirmed: "Confirmed",
   recent: "Recent",
   estimated: "Estimated",
   unknown: "Unknown",
+  not_verified: "Not verified",
 };
 
 export function TruthBadge({ label }: { label: TruthLabel }) {
-  return <span className={`truth-badge truth-${label}`}>{names[label]}</span>;
+  const style = label === "not_verified" ? "truth-dashed" : "truth-filled";
+  return <span className={`truth-badge ${style} truth-${label}`}>{names[label]}</span>;
 }
